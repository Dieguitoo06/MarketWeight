@{
    ViewData["Title"] = "Ingresar Dinero";
}

<div class="card">
    <h1 class="h4 mb-3">Ingresar Dinero</h1>
    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-info">@msg</div>
    }
    <p>Saldo actual: <strong>@(ViewData["Saldo"] ?? 0)</strong></p>
    <form asp-action="Ingresar" method="post" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-auto">
            <input class="form-control" type="number" step="0.01" min="0.01" name="monto" placeholder="Monto" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Ingresar</button>
        </div>
        <div class="col-12 mt-2">
            <a class="btn btn-secondary" asp-action="Index">Volver</a>
        </div>
    </form>
</div>


