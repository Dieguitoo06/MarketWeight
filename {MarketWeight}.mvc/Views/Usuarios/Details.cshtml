@model _MarketWeight_.mvc.Models.UsuarioDto

@{
    ViewData["Title"] = "Detalle Usuario";
}

@* Vista de detalles de usuario
    Muestra información del perfil del usuario incluyendo su billetera de criptomonedas
    Los administradores pueden cambiar el rol del usuario desde aquí
*@
<h1>Detalle Usuario</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.IdUsuario</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Apellido</dt>
    <dd class="col-sm-10">@Model.Apellido</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Saldo</dt>
    <dd class="col-sm-10">@Model.Saldo.ToString("N2")</dd>

    <dt class="col-sm-2">Rol</dt>
    <dd class="col-sm-10">
        @if (Model.EsAdmin)
        {
            <span class="badge bg-danger">Administrador</span>
        }
        else
        {
            <span class="badge bg-secondary">Usuario</span>
        }
    </dd>
</dl>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
    @if (User.IsInRole("Admin") && Model.IdUsuario.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
    {
        <form asp-action="ToggleAdmin" method="post" class="d-inline ms-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdUsuario" />
            <button type="submit" class="btn @(Model.EsAdmin ? "btn-warning" : "btn-success")">
                @(Model.EsAdmin ? "Degradar a Usuario" : "Promover a Admin")
            </button>
        </form>
    }
</p>

@{
    var billetera = ViewData["Billetera"] as List<MarketWeight.Core.UsuarioMoneda> ?? new();
}

<h2>Billetera</h2>
@if (billetera.Count == 0)
{
    <p>No hay monedas en la billetera.</p>
}
else
{
    <table class="table table-striped">
        <thead>
                <tr>
                    <th>IdMoneda</th>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in billetera)
            {
                <tr>
                    <td>@item.idMoneda</td>
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad.ToString("N2")</td>
                </tr>
            }
            </tbody>
    </table>
}
