@model _MarketWeight_.mvc.Models.UsuarioDto

@{
    ViewData["Title"] = "Detalle Usuario";
}

<h1>Detalle Usuario</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.IdUsuario</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Apellido</dt>
    <dd class="col-sm-10">@Model.Apellido</dd>

    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>

    <dt class="col-sm-2">Saldo</dt>
    <dd class="col-sm-10">@Model.Saldo</dd>
</dl>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</p>


