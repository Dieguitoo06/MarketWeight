@model IEnumerable<_MarketWeight_.mvc.Models.UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
}

@* Página de listado de usuarios
    Muestra todos los usuarios registrados en el sistema con su información básica y rol
*@
<div class="section-title">
    <h1 class="h4 m-0">Usuarios</h1>
    <span class="pill">@Model.Count() registros</span>
  </div>

@* Crear usuario vía UI ya no es necesario; se elimina el botón *@

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Saldo</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Nombre</td>
            <td>@u.Apellido</td>
            <td>@u.Email</td>
            <td>@u.Saldo.ToString("N2")</td>
            <td>
                @if (u.EsAdmin)
                {
                    <span class="badge bg-danger">Admin</span>
                }
                else
                {
                    <span class="badge bg-secondary">Usuario</span>
                }
            </td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@u.IdUsuario">Detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>


