@model IEnumerable<_MarketWeight_.mvc.Models.UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Nuevo Usuario</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Saldo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Nombre</td>
            <td>@u.Apellido</td>
            <td>@u.Email</td>
            <td>@u.Saldo</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@u.IdUsuario">Detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>


