@{
    ViewData["Title"] = "Register";
}

<div class="auth-wrapper">
    <div class="card auth-card">
        <h1 class="h3 mb-3">Crear cuenta</h1>
        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input id="nombre" name="nombre" class="form-control" placeholder="Juan" />
            </div>
            <div class="mb-3">
                <label for="apellido" class="form-label">Apellido</label>
                <input id="apellido" name="apellido" class="form-control" placeholder="Pérez" />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="email" class="form-control" placeholder="juan@correo.com" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control" placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
        </form>
    </div>
</div>


