@model _MarketWeight_.mvc.Models.HistorialDto

@{
    ViewData["Title"] = "Detalle Historial";
}

@* Vista de detalles de un registro de historial
    Muestra toda la información de una transacción específica incluyendo usuario, moneda, cantidad y fecha
*@
<h1>Detalle Historial</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.IdHistorial</dd>

    <dt class="col-sm-2">Usuario</dt>
    <dd class="col-sm-10">@Model.IdUsuario</dd>

    <dt class="col-sm-2">Moneda</dt>
    <dd class="col-sm-10">@Model.IdMoneda</dd>

    <dt class="col-sm-2">Cantidad</dt>
    <dd class="col-sm-10">@Model.Cantidad</dd>

    <dt class="col-sm-2">Compra</dt>
    <dd class="col-sm-10">@(Model.Compra ? "Sí" : "No")</dd>

    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.FechaHora</dd>
</dl>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</p>


