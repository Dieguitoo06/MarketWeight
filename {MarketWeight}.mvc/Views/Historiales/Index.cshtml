@model IEnumerable<_MarketWeight_.mvc.Models.HistorialDto>

@{
    ViewData["Title"] = "Historial";
}

@* Página de historial de transacciones
    Muestra el registro completo de todas las compras y ventas de criptomonedas realizadas en el sistema
*@
<h1>Historial</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Usuario</th>
            <th>Moneda</th>
            <th>Cantidad</th>
            <th>Compra</th>
            <th>Fecha</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.IdHistorial</td>
            <td>@r.IdUsuario</td>
            <td>@r.IdMoneda</td>
            <td>@r.Cantidad</td>
            <td>@(r.Compra ? "Sí" : "No")</td>
            <td>@r.FechaHora</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@r.IdHistorial">Detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>


