@{
    ViewData["Title"] = "Comprar Criptomonedas";
    var monedas = ViewData["Monedas"] as List<MarketWeight.Core.Moneda> ?? new();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header" style="margin: -12px -12px 0 -12px;">
                    <h2 class="mb-0" style="color: white;">💰 Comprar Criptomonedas</h2>
                </div>
                
                @if (TempData["Message"] is string msg)
                {
                    <div class="alert alert-info mt-3">@msg</div>
                }

                <form asp-action="Buy" method="post" id="buyForm">
                    @Html.AntiForgeryToken()
                    
                    <!-- Selección de Moneda -->
                    <div class="mb-4">
                        <label class="form-label" for="idMoneda">Selecciona una Moneda</label>
                        <select class="form-select form-select-lg" id="idMoneda" name="idMoneda">
                            <option value="">-- Selecciona una moneda --</option>
                            @foreach (var m in monedas)
                            {
                                <option value="@m.IdMoneda" data-precio="@m.Precio.ToString("N2")" data-stock="@m.Cantidad.ToString("N2")">
                                    @m.Nombre
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Información de la Moneda -->
                    <div class="row mb-4">
                        <div class="col-12 col-sm-6">
                            <div class="bg-dark p-3 rounded" style="background: rgba(14, 165, 233, 0.05) !important; border: 1px solid var(--accent-1);">
                                <small class="text-muted d-block mb-1">Precio Unitario</small>
                                <h4 class="mb-0" id="precioSel" style="color: var(--accent-1); font-weight: 700;">-</h4>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="bg-dark p-3 rounded" style="background: rgba(16, 185, 129, 0.05) !important; border: 1px solid var(--accent-3);">
                                <small class="text-muted d-block mb-1">Stock Disponible</small>
                                <h4 class="mb-0" id="stockSel" style="color: var(--accent-3); font-weight: 700;">-</h4>
                            </div>
                        </div>
                    </div>

                    <!-- Cantidad y Total -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="cantidad">Cantidad a Comprar</label>
                            <input class="form-control form-control-lg" id="cantidad" name="cantidad" type="number" step="0.01" min="0.01" placeholder="Ingresa cantidad" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label">&nbsp;</label>
                            <div class="bg-dark p-3 rounded h-94 d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(6, 182, 212, 0.1)) !important; border: 2px solid var(--accent-2);">
                                <small class="text-muted d-block mb-1">Total a Pagar</small>
                                <h3 class="mb-0" id="totalSel" style="color: var(--accent-2); font-weight: 700;">-</h3>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de Acción -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-check-circle"></i> Comprar Ahora
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <!-- Información de Monedas Disponibles -->
                <div>
                    <h5 class="mb-3">Monedas Disponibles</h5>
                    <div class="row g-2">
                        @foreach (var m in monedas)
                        {
                            <div class="col-12 col-sm-6">
                                <div class="p-3 rounded border border-secondary" style="background: rgba(0, 0, 0, 0.2); cursor: pointer; transition: all 0.3s;" 
                                     onclick="document.getElementById('idMoneda').value='@m.IdMoneda'; document.getElementById('cantidad').focus();">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="mb-1">@m.Nombre</h6>
                                            <small class="text-muted">Precio: <strong style="color: var(--accent-1);">@m.Precio.ToString("N2")</strong></small>
                                        </div>
                                        <small class="text-success">Stock: @m.Cantidad.ToString("N2")</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function(){
        const select = document.getElementById('idMoneda');
        const qty = document.getElementById('cantidad');
        const precioSpan = document.getElementById('precioSel');
        const stockSpan = document.getElementById('stockSel');
        const totalSpan = document.getElementById('totalSel');

        function updateInfo() {
            const opt = select.options[select.selectedIndex];
            if (!opt || !opt.value) {
                precioSpan.textContent = '-';
                stockSpan.textContent = '-';
                totalSpan.textContent = '-';
                return;
            }
            const precio = parseFloat(opt.getAttribute('data-precio')) || 0;
            const stock = parseFloat(opt.getAttribute('data-stock')) || 0;
            const cantidad = parseFloat(qty.value) || 0;
            precioSpan.textContent = precio.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            stockSpan.textContent = stock.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            totalSpan.textContent = (precio * cantidad).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        select.addEventListener('change', updateInfo);
        qty.addEventListener('input', updateInfo);
        updateInfo();
    })();
</script>
}



