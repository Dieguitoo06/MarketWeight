@model _MarketWeight_.mvc.Models.MonedaDto

@{
    ViewData["Title"] = "Detalle Moneda";
}

<h1>Detalle Moneda</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.IdMoneda</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Precio</dt>
    <dd class="col-sm-10">@Model.Precio</dd>

    <dt class="col-sm-2">Cantidad</dt>
    <dd class="col-sm-10">@Model.Cantidad</dd>
</dl>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</p>

@* Compra removida del detalle; usar la página Comprar del menú *@

