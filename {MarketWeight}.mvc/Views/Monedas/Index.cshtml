@model IEnumerable<_MarketWeight_.mvc.Models.MonedaDto>

@{
    ViewData["Title"] = "Monedas";
}

<div class="section-title">
    <h1 class="h4 m-0">Monedas</h1>
    <span class="pill">@Model.Count() registros</span>
  </div>

@* Crear moneda permanece si lo necesitas *@

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Nombre</td>
            <td>@m.Precio</td>
            <td>@m.Cantidad</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@m.IdMoneda">Detalle</a>
            </td>
        </tr>
    }
    </tbody>
</table>


