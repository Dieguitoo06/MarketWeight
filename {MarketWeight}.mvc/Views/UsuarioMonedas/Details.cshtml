@model _MarketWeight_.mvc.Models.UsuarioMonedaDto

@{
    ViewData["Title"] = "Detalle Billetera";
}

@* Vista de detalles de una moneda en la billetera
    Muestra la información de una criptomoneda específica que posee un usuario
*@
<h1>Detalle Billetera</h1>

<dl class="row">
    <dt class="col-sm-2">Usuario</dt>
    <dd class="col-sm-10">@Model.IdUsuario</dd>

    <dt class="col-sm-2">Moneda</dt>
    <dd class="col-sm-10">@Model.IdMoneda</dd>

    <dt class="col-sm-2">Cantidad</dt>
    <dd class="col-sm-10">@Model.Cantidad.ToString("N2")</dd>
</dl>

<p>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</p>


